5:["$","section",null,{"children":[["$","h2",null,{"children":"Third-party links and embeds"}],["$","p",null,{"children":"This website links to external services such as the university portal, results systems and social networks. Once you follow a link, the destination site’s own privacy policy applies. We are not responsible for the data practices of third parties. The embedded map loads content from Google under its own terms."}]]}]
