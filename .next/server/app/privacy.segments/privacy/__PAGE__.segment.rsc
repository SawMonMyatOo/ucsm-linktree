7:["$","section",null,{"children":[["$","h2",null,{"children":"Your rights"}],["$","p",null,{"children":"Depending on where you live, you may have the right to access, correct, delete or port your personal data, to withdraw consent, and to object to certain processing. Because we hold very little data, most requests can be satisfied simply by clearing your browser storage. To exercise any right, contact us using the details below."}]]}]
8:["$","section",null,{"children":[["$","h2",null,{"children":"Security"}],["$","p",null,{"children":"The site is served exclusively over HTTPS, fonts and scripts are self-hosted where possible to limit third-party exposure, and access to the hosting environment is restricted to authorised IT staff."}]]}]
